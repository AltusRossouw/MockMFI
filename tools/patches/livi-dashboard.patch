+        coolant_ratio: num(&t["coolantC"])
+            .map(|c| (c.clamp(COOLANT_MIN_C, COOLANT_MAX_C) - COOLANT_MIN_C) / (COOLANT_MAX_C - COOLANT_MIN_C))
+            .unwrap_or(0.0),
