+/// "8.4 L/100 · trip 312 km", or empty when the bridge has no consumption yet.
+/// The trip computer: distance, average consumption and the litres that implies.
+fn trip_text(t: &Value) -> String {
+    let km = num(&t["odometerTripKm"]);
+    let avg = num(&t["consumptionAvgLPer100Km"]);
+    match (km, avg) {
+        (Some(km), Some(avg)) if km >= 0.1 && avg > 0.0 => {
+            format!("TRIP {km:.0} km · {avg:.1} L/100 · {:.1} L", avg * km / 100.0)
+        }
+        (Some(km), _) if km >= 0.1 => format!("TRIP {km:.0} km"),
+        _ => String::new(),
+    }
+}
+
+fn economy_text(t: &Value) -> String {
+    let mut parts: Vec<String> = Vec::new();
+    match num(&t["consumptionLPer100Km"]) {
+        Some(c) => parts.push(format!("{c:.1} L/100")),
+        // standing still: L/100 km is meaningless, litres per hour is not
+        None => {
+            if let Some(r) = num(&t["fuelRateLph"]) {
+                parts.push(format!("{r:.1} L/h"));
+            }
+        }
+    }
+    parts.join(" · ")
+}
+
+const COOLANT_MIN_C: f64 = 40.0;
+const COOLANT_MAX_C: f64 = 120.0;
+const COOLANT_WARN_C: f64 = 105.0;
+const INTAKE_MIN_C: f64 = -10.0;
+const INTAKE_MAX_C: f64 = 60.0;
+
