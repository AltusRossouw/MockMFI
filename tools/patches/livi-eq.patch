+/// Linear gain from a dB value, clamped to a sane ceiling.
+pub fn preamp_gain(db: f64) -> f64 {
+    10f64.powf(db.clamp(-24.0, 18.0) / 20.0)
+}
+
+pub fn apply_preamp(element: &gst::Element, db: f64) {
+    element.set_property("volume", preamp_gain(db));
+}
+
+/// Band centres of `equalizer-10bands`: 29 Hz .. 15 kHz.
+pub const EQ_BANDS: usize = 10;
+
+/// Map the three sliders onto the ten bands: bass covers 29-119 Hz, mid 237 Hz-1.9 kHz,
+/// treble 3.8-15 kHz. Three shelves could not reach the 4-8 kHz region that matters here.
+pub fn band_gains(eq: Eq) -> [f64; EQ_BANDS] {
+    let (b, m, t) = if eq.enabled {
+        (
+            eq.bass_db.clamp(-12.0, 12.0),
+            eq.mid_db.clamp(-12.0, 12.0),
+            eq.treble_db.clamp(-12.0, 12.0),
+        )
+    } else {
+        (0.0, 0.0, 0.0)
+    };
+    let group = [b, b, b, m, m, m, m, t, t, t];
+    let mut out = [0.0; EQ_BANDS];
+    for i in 0..EQ_BANDS {
+        out[i] = (group[i] + eq.bands[i]).clamp(-24.0, 12.0);
+    }
+    out
+}
+
+/// The equalizer fragment of a launch line, gains included. Setting properties after
+/// `parse::launch` proved unreliable on this build, so the values are baked in and
+/// `apply_eq` is only used for later changes.
+pub fn eq_fragment(eq: Eq) -> String {
+    let mut text = String::from("equalizer-10bands name=eq");
+    for (index, gain) in band_gains(eq).into_iter().enumerate() {
+        text.push_str(&format!(" band{index}={gain}"));
+    }
+    text
+}
+
+pub fn apply_eq(eq_element: &gst::Element, eq: Eq) {
+    for (index, gain) in band_gains(eq).into_iter().enumerate() {
+        eq_element.set_property(&format!("band{index}"), gain);
+    }
+}
