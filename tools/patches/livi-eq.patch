+
+/// The equaliser settings LIVI's UI writes into config.json, read here so a
+/// slider takes effect without a protocol change.
+fn eq_from_config() -> livi_audio::player::Eq {
+    use livi_audio::player::Eq;
+    let path = std::env::var("HOME")
+        .map(|h| std::path::Path::new(&h).join(".config/LIVI/config.json"))
+        .unwrap_or_default();
+    let Ok(text) = std::fs::read_to_string(&path) else {
+        return Eq::default();
+    };
+    let Ok(v) = serde_json::from_str::<serde_json::Value>(&text) else {
+        return Eq::default();
+    };
+    let num = |k: &str| v.get(k).and_then(|x| x.as_f64()).unwrap_or(0.0);
+    let mut bands = [0.0f64; livi_audio::player::EQ_BANDS];
+    for (i, band) in bands.iter_mut().enumerate() {
+        *band = num(&format!("eqBand{i}Db"));
+    }
+    Eq {
+        enabled: v.get("eqEnabled").and_then(|x| x.as_bool()).unwrap_or(false),
+        bass_db: num("eqBassDb"),
+        mid_db: num("eqMidDb"),
+        treble_db: num("eqTrebleDb"),
+        bands,
+    }
+}
+
+/// The preamp gain the UI writes, in dB.
+fn preamp_from_config() -> f64 {
+    let path = std::env::var("HOME")
+        .map(|h| std::path::Path::new(&h).join(".config/LIVI/config.json"))
+        .unwrap_or_default();
+    let Ok(text) = std::fs::read_to_string(&path) else {
+        return 0.0;
+    };
+    let Ok(v) = serde_json::from_str::<serde_json::Value>(&text) else {
+        return 0.0;
+    };
+    v.get("preampDb").and_then(|x| x.as_f64()).unwrap_or(0.0)
+}
+
+/// Follow config.json while an audio stream plays, so the sliders are live.
+fn watch_audio(eq: gst::Element, preamp: gst::Element) {
+    let path = std::env::var("HOME")
+        .map(|h| std::path::Path::new(&h).join(".config/LIVI/config.json"))
+        .unwrap_or_default();
+    let stamp = |p: &std::path::Path| std::fs::metadata(p).and_then(|m| m.modified()).ok();
+    std::thread::spawn(move || {
+        let mut last = stamp(&path);
+        loop {
+            std::thread::sleep(std::time::Duration::from_secs(2));
+            let now = stamp(&path);
+            if now == last {
+                continue;
+            }
+            last = now;
+            livi_audio::player::apply_eq(&eq, eq_from_config());
+            livi_audio::player::apply_preamp(&preamp, preamp_from_config());
+        }
+    });
+}
+
+/// The test tone the Equaliser page asks for ("" none, "pink" pink noise).
+fn test_tone_from_config() -> String {
+    let path = std::env::var("HOME")
+        .map(|h| std::path::Path::new(&h).join(".config/LIVI/config.json"))
+        .unwrap_or_default();
+    let Ok(text) = std::fs::read_to_string(&path) else {
+        return String::new();
+    };
+    let Ok(v) = serde_json::from_str::<serde_json::Value>(&text) else {
+        return String::new();
+    };
+    v.get("testTone")
+        .and_then(|x| x.as_str())
+        .unwrap_or("")
+        .to_string()
+}
+
+/// Ask gst-host to follow the test-tone setting. Call once at startup.
+pub fn start_test_tone() {
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    ONCE.call_once(|| {
+        let _ = gst::init();
+        std::thread::spawn(|| {
+            let mut playing: Option<gst::Element> = None;
+            let mut last = String::new();
+            loop {
+                std::thread::sleep(std::time::Duration::from_secs(1));
+                // the tone must follow the equaliser, so a change of gains or of the
+                // on/off switch rebuilds it just like a change of the tone itself
+                let wanted = test_tone_from_config();
+                let signature = format!(
+                    "{wanted}|{:?}|{:.2}|{:.2}|{:.2}|{:.2}|{:?}",
+                    eq_from_config().enabled,
+                    eq_from_config().bass_db,
+                    eq_from_config().mid_db,
+                    eq_from_config().treble_db,
+                    preamp_from_config(),
+                    eq_from_config().bands
+                );
+                if signature == last {
+                    continue;
+                }
+                last = signature;
+
+                // stop and rebuild in the same tick, otherwise a stale pipeline can
+                // survive a tick and be what the microphone hears
+                if let Some(p) = playing.take() {
+                    let _ = p.set_state(gst::State::Null);
+                }
+                if wanted.is_empty() {
+                    continue;
+                }
+                match pipeline_eq_and_preamp(&wanted) {
+                    Some(p) => {
+                        let _ = p.set_state(gst::State::Playing);
+                        playing = Some(p);
+                    }
+                    None => eprintln!("[tone] cannot build the test tone pipeline"),
+                }
+            }
+        });
+    });
+}
+
+fn pipeline_eq_and_preamp(kind: &str) -> Option<gst::Element> {
+    let source = if kind == "sweep" {
+        "audiotestsrc is-live=true wave=sine freq=1000"
+    } else {
+        "audiotestsrc is-live=true wave=pink-noise"
+    };
+    let desc = format!(
+        "{source} ! audioconvert ! volume name=preamp volume={preamp} ! {eq} \
+         ! audioconvert ! audioresample \
+         ! audio/x-raw,format=S16LE,rate=48000,channels=2 ! pulsesink sync=false",
+        preamp = livi_audio::player::preamp_gain(preamp_from_config()),
+        eq = livi_audio::player::eq_fragment(eq_from_config()),
+    );
+    let element = gst::parse::launch(&desc).ok()?;
+    if let Ok(bin) = element.clone().downcast::<gst::Bin>() {
+        if let Some(eq) = bin.by_name("eq") {
+            livi_audio::player::apply_eq(&eq, eq_from_config());
+        }
+        if let Some(pre) = bin.by_name("preamp") {
+            livi_audio::player::apply_preamp(&pre, preamp_from_config());
+        }
+    }
+    Some(element)
+}
